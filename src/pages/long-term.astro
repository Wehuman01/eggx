---
import BaseLayout from "../components/BaseLayout.astro";
import OfferCard from "../components/OfferCard.astro";
import { offers } from "../content/offers";
import { activeOffers, byKind, byAccess, expiryOrder } from "../lib/offers";
import { UI } from "../lib/i18n";
import { itemListSchema } from "../lib/jsonld";

const ui = UI.zh;
const list = expiryOrder(byAccess(byKind(activeOffers(offers), "long-term"), "public"));
---

<BaseLayout
  locale="zh"
  route="/long-term/"
  title="长期羊毛 — eggx"
  description={ui.longTermBlurb}
  structuredData={[itemListSchema(list, ui.longTermTitle, "zh")]}
>
  <div class="main-inner">
    <header class="page-head">
      <h1>{ui.longTermTitle}</h1>
      <p>{ui.longTermBlurb}</p>
    </header>

    {list.length > 0 ? (
      list.map((offer) => <OfferCard offer={offer} locale="zh" />)
    ) : (
      <p class="empty">{ui.emptyList}</p>
    )}
  </div>
</BaseLayout>
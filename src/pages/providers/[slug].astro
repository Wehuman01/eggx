---
import BaseLayout from "../../components/BaseLayout.astro";
import OfferCard from "../../components/OfferCard.astro";
import { offers } from "../../content/offers";

interface Props {
  slug: string;
}

export function getStaticPaths() {
  const providers = [...new Set(offers.map((o) => o.provider))];
  return providers.map((provider) => ({
    params: { slug: provider.toLowerCase().replace(/\s+/g, "-") },
  }));
}

const { slug } = Astro.params;

const providerOffers = offers.filter(
  (o) => o.provider.toLowerCase().replace(/\s+/g, "-") === slug
);
const providerName = providerOffers[0]?.provider ?? slug;

// Aggregate access and evidence disclosure for the provider page.
const accessLevels = [...new Set(providerOffers.map((o) => o.access))];
const evidenceLevels = [...new Set(providerOffers.map((o) => o.evidence))];
---

<BaseLayout title={`${providerName} — eggx`} description={`Free and limited-time offers from ${providerName}.`}>
  <div class="container">
    <header class="site-header">
      <h1>{providerName}</h1>
      <p>Offers, official sources, and access requirements.</p>
    </header>

    <section class="provider-facts">
      <h2 class="section-title">Disclosure</h2>
      <ul class="offer-facts">
        <li>
          <span class="fact-label">Access</span>
          {accessLevels.join(", ")}
        </li>
        <li>
          <span class="fact-label">Evidence</span>
          {evidenceLevels.join(", ")}
        </li>
        <li>
          <span class="fact-label">Offers</span>
          {providerOffers.length}
        </li>
      </ul>
    </section>

    {providerOffers.length > 0 ? (
      providerOffers.map((offer) => <OfferCard offer={offer} />)
    ) : (
      <p class="empty">No verified offers for this provider.</p>
    )}

    {providerOffers.filter((o) => o.source || o.actionUrl).length > 0 && (
      <section class="provider-facts">
        <h2 class="section-title">Official sources &amp; action links</h2>
        <ul class="offer-facts">
          {providerOffers.map((offer) => (
            <li>
              <span class="fact-label">{offer.name}</span>
              {offer.source && (
                <span>
                  Source:{" "}
                  {offer.source.startsWith("http") ? (
                    <a href={offer.source} target="_blank" rel="noopener">{offer.source}</a>
                  ) : (
                    offer.source
                  )}
                </span>
              )}
              {offer.actionUrl && (
                <span>
                  {" "}· Action:{" "}
                  <a href={offer.actionUrl} target="_blank" rel="noopener">Open</a>
                </span>
              )}
            </li>
          ))}
        </ul>
      </section>
    )}
  </div>
</BaseLayout>
---
import BaseLayout from "../../components/BaseLayout.astro";
import OfferCard from "../../components/OfferCard.astro";
import { daily } from "../../content/daily";
---

<BaseLayout
  title="Daily — eggx"
  description="Today's featured free and limited-time offers for AI coding workflows."
>
  <div class="container">
    <header class="site-header">
      <h1>Daily offers</h1>
      <p>Current highlights, updated as offers are added or removed.</p>
    </header>

    <section>
      {daily.length > 0 ? (
        daily.map((offer) => <OfferCard offer={offer} />)
      ) : (
        <p class="empty">No offers today.</p>
      )}
    </section>
  </div>
</BaseLayout>
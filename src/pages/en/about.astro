---
import BaseLayout from "../../components/BaseLayout.astro";
import { UI, pageUrl } from "../../lib/i18n";
import { faqSchema } from "../../lib/jsonld";

const ui = UI.en;

const faq = faqSchema([
  {
    question: "What kinds of offers does eggx list?",
    answer:
      "eggx splits offers into three sections: temporary offers are public limited-time campaigns sorted by expiry, long-term offers are recurring free tiers and programs, and application offers require an application, verification, or review to claim.",
  },
  {
    question: "What is the difference between official and community offers?",
    answer:
      "Official offers are confirmed by current provider documentation or program pages. Community offers have reproducible community reports, but the provider's terms are incomplete or ambiguous — confirm independently before relying on them.",
  },
  {
    question: "Does free mean unlimited?",
    answer:
      "Rarely. Unpublished limits stay labeled as unpublished instead of being assumed unlimited. Read each offer's limits and how-to-claim before you depend on it, especially under heavy or production use.",
  },
  {
    question: "Are expired offers deleted?",
    answer:
      "No. Expired or delisted offers are archived, not deleted, keeping a public audit trail. An archived entry only records its past verification — it does not mean the offer still works.",
  },
]);
---

<BaseLayout
  locale="en"
  route="/about/"
  title="About — eggx"
  description="eggx's editorial policy, verification standards, and why free is not unlimited."
  structuredData={[faq]}
>
  <div class="main-inner">
    <div class="prose">
      <h1>{ui.navAbout}</h1>

      <h2>Three kinds of offers</h2>
      <p>Offers here fall into three sections:</p>
      <ul>
        <li>
          <strong>Temporary offers</strong> — public limited-time campaigns,
          usually with an end date, sorted by when they expire.
        </li>
        <li>
          <strong>Long-term offers</strong> — public, recurring free tiers and
          programs you can rely on, though each still has its own usage limits.
        </li>
        <li>
          <strong>Application offers</strong> — benefits that require an
          application, verification, or review to claim; grouped in their own
          section.
        </li>
      </ul>

      <h2>Official vs community</h2>
      <p>Every offer carries a trust tag:</p>
      <ul>
        <li>
          <strong>official</strong> — current provider documentation or program page
          confirms the offer.
        </li>
        <li>
          <strong>community</strong> — multiple reproducible reports exist, but the
          provider's terms are incomplete or ambiguous; treat it as a lead that needs
          your own second confirmation.
        </li>
      </ul>
      <p>
        Third-party sources are welcome as leads; we verify against the official
        source before listing. Unconfirmed reports are clearly marked rather than
        presented as verified.
      </p>

      <h2>Free is not unlimited</h2>
      <p>
        A free offer rarely means an unlimited one. Unknown limits stay unknown: we
        mark them as <em>not published</em> instead of inferring they are unlimited.
        Read each offer's limits and access requirements before relying on it,
        especially for production or high-volume work.
      </p>

      <h2>Expired offers are archived, not deleted</h2>
      <p>
        Removed or expired offers are archived rather than deleted, so the public
        audit trail is preserved. An unavailable source is shown as a prior
        verification — never as evidence of continued availability. The archive
        lives on the <a href={pageUrl("en", "/expired/")}>expired deals</a> page: like arsenic,
        long dead and worth nothing — kept for audit, not for claiming.
      </p>

      <h2>A read-only directory</h2>
      <p>
        eggx is a read-only static directory. It collects no user data and stores no
        secrets.
      </p>
    </div>
  </div>
</BaseLayout>
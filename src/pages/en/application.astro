---
import BaseLayout from "../../components/BaseLayout.astro";
import OfferCard from "../../components/OfferCard.astro";
import { offers } from "../../content/offers";
import { activeOffers, byAccess } from "../../lib/offers";
import { UI } from "../../lib/i18n";
import { itemListSchema } from "../../lib/jsonld";

const ui = UI.en;
const list = byAccess(activeOffers(offers), "application");
---

<BaseLayout
  locale="en"
  route="/application/"
  title="Application offers — eggx"
  description={ui.applicationBlurb}
  structuredData={[itemListSchema(list, ui.applicationTitle, "en")]}
>
  <div class="main-inner">
    <header class="page-head">
      <h1>{ui.applicationTitle}</h1>
      <p>{ui.applicationBlurb}</p>
    </header>

    {list.length > 0 ? (
      list.map((offer) => <OfferCard offer={offer} locale="en" />)
    ) : (
      <p class="empty">{ui.emptyList}</p>
    )}
  </div>
</BaseLayout>

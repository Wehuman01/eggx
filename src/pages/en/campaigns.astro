---
import BaseLayout from "../../components/BaseLayout.astro";
import { campaigns, campaignSnapshot } from "../../content/campaigns";
import { beijingDaysUntil, sortActiveCampaigns, type CampaignEvent } from "../../lib/campaigns";
import { UI } from "../../lib/i18n";

const ui = UI.en;
const locale = "en" as const;

const active = sortActiveCampaigns(campaigns.filter((e) => e.status === "active"));
const policies = campaigns.filter((e) => e.status === "active" && e.kind === "policy");
const promos = active.filter((e) => e.kind === "promo");
const ended = campaigns.filter((e) => e.status === "ended");

const tz = "Asia/Shanghai";
const dtFmt = new Intl.DateTimeFormat("en-US", {
  timeZone: tz,
  year: "numeric",
  month: "long",
  day: "numeric",
  hour: "2-digit",
  minute: "2-digit",
  hour12: false,
});
const dayFmt = new Intl.DateTimeFormat("en-US", { timeZone: tz, month: "short", day: "numeric" });
const fullDayFmt = new Intl.DateTimeFormat("en-US", {
  timeZone: tz,
  year: "numeric",
  month: "long",
  day: "numeric",
});

/** Static build-day badge text; recomputed at view time by the inline script. */
function badge(event: CampaignEvent): string | null {
  if (event.endPrecision !== "exact" && event.endPrecision !== "deadline") return null;
  if (!event.endAt) return null;
  const days = beijingDaysUntil(event.endAt);
  if (days < 0) return ui.campaignsEndedTag;
  if (days === 0) return ui.expiringToday;
  return (days === 1 ? ui.daysLeftOne : ui.daysLeftOther).replace("{n}", String(days));
}

function windowText(event: CampaignEvent): string {
  const start = event.startAt ? dayFmt.format(new Date(event.startAt)) : null;
  const end = event.endAt ? dayFmt.format(new Date(event.endAt)) : null;
  if (start && end) return `${start} – ${end}`;
  if (start) return `since ${start}`;
  return event.endPrecision === "none" ? ui.campaignsOngoing : ui.noEndDate;
}

function verifiedText(event: CampaignEvent): string {
  return ui.verifiedOn(event.lastVerified);
}

const checkedAt = dtFmt.format(new Date(campaignSnapshot.checkedAt));
---
<BaseLayout
  locale="en"
  route="/campaigns/"
  title={`${ui.campaignsTitle} — eggx`}
  description={ui.campaignsBlurb}
>
  <div class="main-inner">
    <header class="page-head">
      <h1>{ui.campaignsTitle}</h1>
      <p>{ui.campaignsBlurb}</p>
    </header>

    <div class="agent-chips">
      <span class="chip">{ui.campaignsActiveTemplate.replace("{n}", String(promos.length))}</span>
      <span class="chip">{ui.campaignsEndedTemplate.replace("{n}", String(ended.length))}</span>
      <span class="chip">{ui.verifiedOn(campaignSnapshot.checkedAt.slice(0, 10))}</span>
    </div>

    <section class="reset-history">
      <h2>{ui.campaignsActiveHeading}</h2>
      {promos.length === 0 && <p class="empty">No active campaigns right now.</p>}
      <div class="reset-grid">
        {promos.map((event) => (
          <article class="offer-card">
            <div class="offer-head">
              <h2 class="reset-card-title">{event.title[locale]}</h2>
              <span class="tag tag-outline">{event.vendor}</span>
            </div>
            <p class="stat-line">
              <strong>{ui.campaignsWindowLabel}</strong> · {windowText(event)}
              {badge(event) && (
                <span
                  class="badge-elapsed"
                  data-campaign-end={event.endAt ? event.endAt.slice(0, 10) : undefined}
                  style="margin-left:0.375rem;"
                >
                  {badge(event)}
                </span>
              )}
            </p>
            <p class="offer-desc">{event.detail[locale]}</p>
            <p class="offer-meta">
              <span>{verifiedText(event)}</span>
            </p>
            <a
              class="btn btn-primary offer-action"
              href={event.source}
              rel="noopener"
              target="_blank"
            >{ui.campaignsOfficialAction}</a>
          </article>
        ))}
      </div>
    </section>

    <section class="reset-history">
      <h2>{ui.campaignsPolicyHeading}</h2>
      {policies.map((event) => (
        <article class="reset-row">
          <div class="reset-row-head">
            <span class="reset-row-time">
              {event.startAt ? fullDayFmt.format(new Date(event.startAt)) : "—"}
            </span>
            <span class="tag tag-outline">{event.vendor}</span>
            <span class="tag tag-community">{ui.campaignsKindPolicy}</span>
          </div>
          <p class="reset-scope"><strong>{event.title[locale]}</strong></p>
          <p class="reset-scope">{event.detail[locale]}</p>
          <p class="reset-scope">
            <a href={event.source} rel="noopener" target="_blank">{ui.campaignsOfficialAction} ↗</a>
            · {verifiedText(event)}
          </p>
        </article>
      ))}
    </section>

    <section class="reset-history">
      <h2>{ui.campaignsEndedHeading}</h2>
      {ended.map((event) => (
        <article class="reset-row">
          <div class="reset-row-head">
            <span class="reset-row-time">
              {event.startAt ? dayFmt.format(new Date(event.startAt)) : "?"} –
              {event.endAt ? dayFmt.format(new Date(event.endAt)) : "?"}
            </span>
            <span class="tag tag-outline">{event.vendor}</span>
            <span class="tag tag-community">{ui.campaignsEndedTag}</span>
          </div>
          <p class="reset-scope"><strong>{event.title[locale]}</strong></p>
          <p class="reset-scope">{event.detail[locale]}</p>
          <p class="reset-scope">
            <a href={event.source} rel="noopener" target="_blank">{ui.campaignsOfficialAction} ↗</a>
          </p>
        </article>
      ))}
    </section>

    <section class="prose reset-method">
      <h2>{ui.methodHeading}</h2>
      <ul>
        <li>
          <strong>Inclusion rule</strong> — only entries verifiable on an official vendor page
          (docs notices, campaign pages, changelogs) make it here, each with the official link and
          a human-verified date. Community-only leads stay in the temporary offers catalog.
        </li>
        <li>
          <strong>Status semantics</strong> — "Active" means the official announcement is still in
          force. Published end dates get a live countdown; "limited time" without a date is marked
          as no end published, never guessed. Policy changes (billing migrations, discontinuations)
          are listed separately because they decide whether a deal keeps working.
        </li>
        <li>
          <strong>{ui.campaignsChannelHeading}</strong> —
          {campaignSnapshot.channels.map((c, i) => (
            <>{i > 0 && " · "}<a href={c.url} rel="noopener" target="_blank">{c.vendor}</a></>
          ))}
        </li>
        <li>
          <strong>Watchlist</strong> — Qwen and WorkBuddy announcement pages render client-side
          only and are checked manually for now; parts of MiniMax and Kimi campaign/pricing pages
          likewise need eyes. Xiaomi MiMo has no first-party coding plan and is not tracked.
        </li>
        <li><strong>Time zone</strong> — everything is Beijing time (UTC+8).</li>
        <li>
          <strong>Disclaimer</strong> — not an official vendor page; campaign terms live on the
          official pages, and "ongoing" never implies a forever promise.
        </li>
      </ul>
    </section>

    <p class="reset-footnote">
      Verified up to {checkedAt} · {campaignSnapshot.verifiedBy} · not an official vendor page
    </p>
  </div>

  <script
    type="application/json"
    id="eggx-campaign-i18n"
    set:html={JSON.stringify({
      expiringToday: ui.expiringToday,
      daysLeftOne: ui.daysLeftOne,
      daysLeftOther: ui.daysLeftOther,
      endedTag: ui.campaignsEndedTag,
    })}
  />
  {/* Static HTML carries build-day countdowns; recompute from Beijing calendar
      dates at view time so the page stays honest between deploys. */}
  <script is:inline>
    (function () {
      var cfgEl = document.getElementById("eggx-campaign-i18n");
      if (!cfgEl) return;
      var cfg = JSON.parse(cfgEl.textContent || "{}");
      var BJ_OFFSET = 8 * 3600000;
      function beijingDay(ms) {
        var d = new Date(ms + BJ_OFFSET);
        return Date.UTC(d.getUTCFullYear(), d.getUTCMonth(), d.getUTCDate());
      }
      var today = beijingDay(Date.now());
      document.querySelectorAll("[data-campaign-end]").forEach(function (el) {
        var end = Date.parse(el.getAttribute("data-campaign-end"));
        if (Number.isNaN(end)) return;
        var days = Math.round((beijingDay(end) - today) / 86400000);
        if (days < 0) el.textContent = cfg.endedTag;
        else if (days === 0) el.textContent = cfg.expiringToday;
        else el.textContent = (days === 1 ? cfg.daysLeftOne : cfg.daysLeftOther).replace("{n}", String(days));
      });
    })();
  </script>
</BaseLayout>

---
import BaseLayout from "../../components/BaseLayout.astro";
import OfferCard from "../../components/OfferCard.astro";
import { offers } from "../../content/offers";
import { activeOffers, byKind, byAccess, expiryOrder } from "../../lib/offers";
import { UI } from "../../lib/i18n";

const ui = UI.en;
const list = expiryOrder(byAccess(byKind(activeOffers(offers), "temporary"), "public"));
---

<BaseLayout
  locale="en"
  route="/"
  title="Temporary offers — eggx"
  description={ui.temporaryBlurb}
>
  <div class="main-inner">
    <header class="page-head">
      <h1>{ui.temporaryTitle}</h1>
      <p>{ui.temporaryBlurb}</p>
    </header>

    {list.length > 0 ? (
      list.map((offer) => <OfferCard offer={offer} locale="en" />)
    ) : (
      <p class="empty">{ui.emptyList}</p>
    )}
  </div>
</BaseLayout>
---
import BaseLayout from "../../components/BaseLayout.astro";
import OfferCard from "../../components/OfferCard.astro";
import { offers } from "../../content/offers";
import { activeOffers, byKind, expiryOrder } from "../../lib/offers";
import { UI } from "../../lib/i18n";

const ui = UI.en;
const list = expiryOrder(byKind(activeOffers(offers), "long-term"));
---

<BaseLayout
  locale="en"
  route="/long-term/"
  title="Long-term offers — eggx"
  description={ui.longTermBlurb}
>
  <div class="main-inner">
    <header class="page-head">
      <h1>{ui.longTermTitle}</h1>
      <p>{ui.longTermBlurb}</p>
    </header>

    {list.length > 0 ? (
      list.map((offer) => <OfferCard offer={offer} locale="en" />)
    ) : (
      <p class="empty">{ui.emptyList}</p>
    )}
  </div>
</BaseLayout>
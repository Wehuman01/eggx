---
import BaseLayout from "../components/BaseLayout.astro";
import { UI } from "../lib/i18n";

const ui = UI.zh;
---

<BaseLayout
  locale="zh"
  route="/about/"
  title="关于 — eggx"
  description="eggx 的编辑准则：核实规则、免费不等于无限、只读目录。"
>
  <div class="main-inner">
    <div class="prose">
      <h1>{ui.navAbout}</h1>

      <h2>三种羊毛</h2>
      <p>
        这里的羊毛分为三栏：
      </p>
      <ul>
        <li>
          <strong>临时羊毛</strong> — 公开的限时活动，一般有截止日期，过期不候，
          按到期时间排序。
        </li>
        <li>
          <strong>长期羊毛</strong> — 公开、持续供应的免费额度与计划，稳定可依赖，
          但仍有各自的使用限制。
        </li>
        <li>
          <strong>申请羊毛</strong> — 需申请、认证或人工审核才能领取的羊毛，
          单独成栏。
        </li>
      </ul>

      <h2>官方核实 vs 社区消息</h2>
      <p>
        每条羊毛都带一个可信度标签：
      </p>
      <ul>
        <li>
          <strong>官方核实</strong> — 由官方文档或项目页确认当前仍可领取。
        </li>
        <li>
          <strong>社区消息</strong> — 有可复现的社区报告，但官方声明不完整或含混，
          需要你自行二次确认。
        </li>
      </ul>
      <p>
        第三方来源是很好的线索，收录前我们会另行核实。无法确认的消息
        会明确标注，而不是当作已核实。
      </p>

      <h2>免费不等于无限</h2>
      <p>
        免费很少意味着无限。未公布的限额就一直保持未公布：我们标注为
        “未公布”，而不是推测它没有上限。依赖前请先读每条羊毛的限额与获取方式，
        尤其在高负载或生产环境的场景下。
      </p>

      <h2>过期羊毛只归档，不删除</h2>
      <p>
        已过期或下架的羊毛会归档保留，而不是删除，以保留公开的审计轨迹。
        一个来源不可用只代表它曾经的核实记录，绝不代表它仍然可用。
      </p>

      <h2>只读目录</h2>
      <p>
        eggx 是一个只读的静态目录：不采集任何用户数据，也不存储任何密钥。
      </p>

      <h2>联系我们</h2>
      <p>
        项目源码开源在 GitHub：
        <a href="https://github.com/wehuman01/eggx" rel="noopener" target="_blank"
          >github.com/wehuman01/eggx</a
        >，欢迎 Star 与 Issue。
      </p>
      <p>
        也可以关注微信公众号获取更新：
      </p>
      <img
        class="qrcode"
        src={`${import.meta.env.BASE_URL}wechat-qrcode.png`}
        width="200"
        height="200"
        alt="微信公众号二维码"
      />
    </div>
  </div>
</BaseLayout>
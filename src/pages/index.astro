---
import BaseLayout from "../components/BaseLayout.astro";
import OfferCard from "../components/OfferCard.astro";
import { offers } from "../content/offers";
import { activeOffers, byKind, byAccess, byVerified, expiryOrder } from "../lib/offers";
import { UI } from "../lib/i18n";
import { itemListSchema } from "../lib/jsonld";

const ui = UI.zh;
const pool = expiryOrder(byAccess(byKind(activeOffers(offers), "temporary"), "public"));
const list = byVerified(pool, true);
const community = byVerified(pool, false);
---

<BaseLayout
  locale="zh"
  route="/"
  title={`${ui.siteTagline} — eggx`}
  description={ui.siteDescription}
  structuredData={[itemListSchema([...list, ...community], ui.temporaryTitle, "zh")]}
>
  <div class="main-inner">
    <header class="page-head">
      <h1>{ui.temporaryTitle}</h1>
      <p>{ui.temporaryBlurb}</p>
    </header>

    {list.length > 0 ? (
      list.map((offer) => <OfferCard offer={offer} locale="zh" />)
    ) : (
      <p class="empty">{ui.emptyList}</p>
    )}

    {community.length > 0 && (
      <section class="community-section">
        <header class="community-head">
          <h2>{ui.communitySectionTitle}</h2>
          <p>{ui.communitySectionBlurb}</p>
        </header>
        {community.map((offer) => <OfferCard offer={offer} locale="zh" />)}
      </section>
    )}
  </div>
</BaseLayout>
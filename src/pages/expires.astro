---
import BaseLayout from "../components/BaseLayout.astro";
import ExpiryList from "../components/ExpiryList.astro";
import { offers } from "../content/offers";
import { activeOffers } from "../lib/offers";

const active = activeOffers(offers);
---

<BaseLayout title="Expiring — eggx" description="Offers currently expiring, ordered by end date.">
  <div class="container">
    <header class="site-header">
      <h1>Expiring offers</h1>
      <p>Dated offers ordered by soonest end date.</p>
    </header>

    <ExpiryList offers={active} />
  </div>
</BaseLayout>
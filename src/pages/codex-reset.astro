---
import BaseLayout from "../components/BaseLayout.astro";
import { resets, resetSnapshot } from "../content/resets";
import {
  byTimeDesc,
  confirmedResetDates,
  eventTime,
  intervalsInDays,
  isConfirmed,
  summarizeIntervals,
  daysSince,
  scopeText,
} from "../lib/resets";
import { UI } from "../lib/i18n";

const ui = UI.zh;
const events = byTimeDesc(resets);

const latestReset = events.find(isConfirmed) ?? null;
const intervals = summarizeIntervals(intervalsInDays(confirmedResetDates(resets)));
const resetCount = resets.filter((e) => e.type === "reset" && isConfirmed(e)).length;
const cardCount = resets.filter((e) => e.type === "card").length;

const tz = "Asia/Shanghai";
const dtFmt = new Intl.DateTimeFormat("zh-CN", {
  timeZone: tz,
  year: "numeric",
  month: "long",
  day: "numeric",
  hour: "2-digit",
  minute: "2-digit",
  hour12: false,
});
const monthFmt = new Intl.DateTimeFormat("zh-CN", { timeZone: tz, year: "numeric", month: "long" });
const dayFmt = new Intl.DateTimeFormat("zh-CN", { timeZone: tz, year: "numeric", month: "long", day: "numeric" });

/** Quote shown on the row: the confirmation when present, else the latest post
    (which is also what eventTime displays). */
function primaryPost(event: (typeof events)[number]) {
  return event.posts.find((p) => p.stage === "confirm") ?? event.posts[event.posts.length - 1];
}

const groups: { label: string; events: typeof events }[] = [];
for (const event of events) {
  const label = monthFmt.format(new Date(eventTime(event)));
  const last = groups[groups.length - 1];
  if (last && last.label === label) {
    last.events.push(event);
  } else {
    groups.push({ label, events: [event] });
  }
}

const elapsedDays = latestReset ? daysSince(latestReset.confirmedAt ?? eventTime(latestReset)) : null;

const historyFrom = dayFmt.format(new Date(resetSnapshot.historyFrom));
const checkedAt = dtFmt.format(new Date(resetSnapshot.checkedAt));
const intervalsText = intervals
  ? ui.intervalsTemplate
      .replace("{min}", String(intervals.min))
      .replace("{median}", String(intervals.median))
      .replace("{max}", String(intervals.max))
      .replace("{count}", String(intervals.count))
  : "";
const historySummary = ui.historySummaryTemplate
  .replace("{from}", historyFrom)
  .replace("{total}", String(resets.length))
  .replace("{resets}", String(resetCount))
  .replace("{cards}", String(cardCount));
---

<BaseLayout
  locale="zh"
  route="/codex-reset/"
  title={`${ui.codexResetTitle} — eggx`}
  description={ui.codexResetBlurb}
>
  <div class="main-inner">
    <header class="page-head">
      <h1>{ui.codexResetTitle}</h1>
      <p>{ui.codexResetBlurb}</p>
    </header>

    <div class="reset-grid">
      <article class="offer-card">
        <div class="offer-head">
          <h2 class="reset-card-title">{ui.lastResetHeading}</h2>
          {latestReset && (
            <span class="tag tag-outline">
              {latestReset.type === "reset" ? ui.resetTypeLabel : ui.cardTypeLabel}
            </span>
          )}
          {latestReset && <span class="tag tag-verified">{ui.confirmedTag}</span>}
        </div>
        {latestReset ? (
          <>
            <p class="reset-when">
              {dtFmt.format(new Date(latestReset.confirmedAt ?? eventTime(latestReset)))}
              <span class="reset-tz">北京时间</span>
            </p>
            {elapsedDays !== null && (
              <p class="reset-elapsed">
                <span class="badge-elapsed" data-since={latestReset.confirmedAt ?? eventTime(latestReset)}>
                  {elapsedDays <= 0 ? ui.todayLabel : ui.daysAgoLabel.replace("{n}", String(elapsedDays))}
                </span>
              </p>
            )}
            <blockquote class="reset-quote">
              {primaryPost(latestReset).zh}
              <footer>
                <a href={primaryPost(latestReset).url} rel="noopener" target="_blank">{ui.sourcePostLabel}</a>
              </footer>
            </blockquote>
          </>
        ) : (
          <p class="empty">还没有已确认的重置记录。</p>
        )}
      </article>

      <article class="offer-card">
        <div class="offer-head">
          <h2 class="reset-card-title">{ui.nextResetHeading}</h2>
        </div>
        {latestReset && elapsedDays !== null ? (
          <>
            <p class="reset-when">
              {elapsedDays <= 0 ? ui.todayLabel : ui.daysAgoLabel.replace("{n}", String(elapsedDays))}
            </p>
            <p class="stat-line" data-intervals>{intervalsText}</p>
          </>
        ) : (
          <p class="stat-line" data-intervals>{intervalsText}</p>
        )}
        <p class="reset-note">{ui.estimateNote}</p>
        <div class="impatient-row">
          <button type="button" class="btn btn-impatient" id="impatient-btn">{ui.impatientAction}</button>
          <span class="impatient-meta">
            <span class="impatient-count" data-impatient-count hidden></span>
            <span class="impatient-hint" data-impatient-hint>{ui.impatientHint}</span>
          </span>
        </div>
        <a
          class="btn btn-primary offer-action"
          href="https://x.com/thsottiaux"
          rel="noopener"
          target="_blank">{ui.followAction}</a
        >
      </article>
    </div>

    <section class="reset-history">
      <h2>{ui.historyHeading}</h2>
      <p class="reset-summary">{historySummary}</p>

      {groups.map((group, index) => (
        <details class="reset-month" open={index === 0}>
          <summary class="reset-month-summary">
            <h3 class="reset-month-label">{group.label}</h3>
            <span class="reset-month-count">
              {ui.monthSummaryTemplate.replace("{n}", String(group.events.length))}
            </span>
          </summary>
          <div class="reset-month-body">
            {group.events.map((event) => {
              const post = primaryPost(event);
              const confirmed = isConfirmed(event);
              const scope = scopeText(event, "zh");
              return (
                <article class="reset-row">
                  <div class="reset-row-head">
                    <span class="reset-row-time">
                      {dtFmt.format(new Date(eventTime(event)))}
                    </span>
                    <span class="tag tag-outline">
                      {event.type === "reset" ? ui.resetTypeLabel : ui.cardTypeLabel}
                    </span>
                    <span class:list={["tag", confirmed ? "tag-verified" : "tag-community"]}>
                      {confirmed ? ui.confirmedTag : ui.announcedTag}
                    </span>
                  </div>
                  {scope && (
                    <p class="reset-scope">{ui.scopeLabel}：{scope}</p>
                  )}
                  <blockquote class="reset-quote reset-quote-row">
                    {post.zh}
                    <footer>
                      <a href={post.url} rel="noopener" target="_blank">{ui.sourcePostLabel}</a>
                    </footer>
                  </blockquote>
                </article>
              );
            })}
          </div>
        </details>
      ))}
    </section>

    <section class="prose reset-method">
      <h2>{ui.methodHeading}</h2>
      <ul>
        <li>
          <strong>来源</strong> — 只记录 Tibo（@thsottiaux）在 X 上的公开宣布；
          中文引文为 AI 翻译（整理自
          <a href={resetSnapshot.source} rel="noopener" target="_blank">AIHOT</a
          >），点「原推」查看英文原文。
        </li>
        <li>
          <strong>口径</strong> — 「全员重置」指所有付费账户的 Codex 额度被清零；
          「发重置卡」指向账户发放可自助使用的重置卡。两类事件都计入
          「最近一次」与间隔统计，且仅计已确认的事件。确认时间是 Tibo 确认推文的发布时间，
          不是精确执行时间。
        </li>
        <li>
          <strong>间隔统计</strong> — 按确认日期去重后（同日多轮只计一天）
          计算相邻两次重置（全员重置或发重置卡）的间隔，自 {historyFrom} 起。
        </li>
        <li><strong>时区</strong> — 全部使用北京时间（UTC+8）。</li>
        <li>
          <strong>免责</strong> — 本页非 OpenAI 官方页面；是否重置、何时重置由 OpenAI 决定，
          任何基于历史间隔的推断仅供参考。
        </li>
        <li>
          <strong>更新</strong> — 定时任务每小时自动同步上游并重建本页；上游
          （AIHOT）约每 15 分钟核验一次 Tibo 的公开帖，核验至 {checkedAt}。
        </li>
      </ul>
    </section>

    <p class="reset-footnote">
      快照核验至 {checkedAt} · 数据整理自
      <a href={resetSnapshot.source} rel="noopener" target="_blank">AIHOT</a>
      · 非 OpenAI 官方页面
    </p>
  </div>

  <script
    type="application/json"
    id="eggx-reset-i18n"
    set:html={JSON.stringify({ todayLabel: ui.todayLabel, daysAgoLabel: ui.daysAgoLabel })}
  />
  <script
    type="application/json"
    id="eggx-impatient"
    set:html={JSON.stringify({
      base: "https://abacus.jasoncameron.dev",
      ns: "eggx-wehuman",
      key: "codex-reset-impatient",
      doneLabel: ui.impatientDone,
      countTemplate: ui.impatientCountTemplate,
      unavailableLabel: ui.impatientUnavailable,
    })}
  />
  {/* The static HTML carries build-day "N 天前" values; recompute at view time
      from Beijing calendar dates so the page stays honest between deploys. */}
  <script is:inline>
    (function () {
      var cfg = document.getElementById("eggx-reset-i18n");
      if (!cfg) return;
      var labels = JSON.parse(cfg.textContent || "{}");
      var BJ_OFFSET = 8 * 3600000;
      function beijingDay(ms) {
        var d = new Date(ms + BJ_OFFSET);
        return Date.UTC(d.getUTCFullYear(), d.getUTCMonth(), d.getUTCDate());
      }
      var today = beijingDay(Date.now());
      document.querySelectorAll("[data-since]").forEach(function (el) {
        var then = beijingDay(Date.parse(el.getAttribute("data-since")));
        var days = Math.round((today - then) / 86400000);
        el.textContent =
          days <= 0 ? labels.todayLabel : labels.daysAgoLabel.replace("{n}", String(days));
      });
    })();
  </script>
  {/* "等不及了" counter: one increment per browser (localStorage), global count
      from a free third-party counter service; degraded state stays honest. */}
  <script is:inline>
    (function () {
      var cfgEl = document.getElementById("eggx-impatient");
      var btn = document.getElementById("impatient-btn");
      var countEl = document.querySelector("[data-impatient-count]");
      var hintEl = document.querySelector("[data-impatient-hint]");
      if (!cfgEl || !btn || !countEl) return;
      var cfg = JSON.parse(cfgEl.textContent || "{}");
      var FLAG = "eggx-impatient-v1";
      function setHint(text) {
        if (hintEl && text) hintEl.textContent = text;
      }
      function renderCount(n) {
        countEl.textContent = cfg.countTemplate.replace("{n}", String(n));
        countEl.hidden = false;
      }
      function markDone() {
        btn.disabled = true;
        btn.textContent = cfg.doneLabel;
      }
      fetch(cfg.base + "/get/" + cfg.ns + "/" + cfg.key)
        .then(function (r) {
          return r.ok ? r.json() : null;
        })
        .then(function (d) {
          if (d && typeof d.value === "number") renderCount(d.value);
          else setHint(cfg.unavailableLabel);
        })
        .catch(function () {
          setHint(cfg.unavailableLabel);
        });
      if (localStorage.getItem(FLAG)) markDone();
      btn.addEventListener("click", function () {
        if (btn.disabled) return;
        fetch(cfg.base + "/hit/" + cfg.ns + "/" + cfg.key)
          .then(function (r) {
            return r.ok ? r.json() : null;
          })
          .then(function (d) {
            if (d && typeof d.value === "number") renderCount(d.value);
            localStorage.setItem(FLAG, "1");
            markDone();
          })
          .catch(function () {
            setHint(cfg.unavailableLabel);
          });
      });
    })();
  </script>
</BaseLayout>

---
import BaseLayout from "../components/BaseLayout.astro";
import { allResets, allResetSnapshot } from "../content/resets-all";
import { impatientSnapshot } from "../content/impatient";
import {
  confirmedResetDates,
  eventTime,
  intervalsInDays,
  isConfirmed,
  summarizeIntervals,
  daysSince,
  scopeText,
} from "../lib/resets";
import { previousRound, roundForCycle } from "../lib/impatient";
import { UI } from "../lib/i18n";

const ui = UI.zh;
const events = allResets;

const latestReset = events.find(isConfirmed) ?? null;
const intervals = summarizeIntervals(intervalsInDays(confirmedResetDates(allResets)));
const resetCount = allResets.filter((e) => e.type === "reset" && isConfirmed(e)).length;
const cardCount = allResets.filter((e) => e.type === "card").length;

const tz = "Asia/Shanghai";
const dtFmt = new Intl.DateTimeFormat("zh-CN", {
  timeZone: tz,
  year: "numeric",
  month: "long",
  day: "numeric",
  hour: "2-digit",
  minute: "2-digit",
  hour12: false,
});
const monthFmt = new Intl.DateTimeFormat("zh-CN", { timeZone: tz, year: "numeric", month: "long" });
const dayFmt = new Intl.DateTimeFormat("zh-CN", { timeZone: tz, year: "numeric", month: "long", day: "numeric" });

/** Quote shown on the row: the confirmation when present, else the latest post
    (which is also what eventTime displays). */
function primaryPost(event: (typeof events)[number]) {
  return event.posts.find((p) => p.stage === "confirm") ?? event.posts[event.posts.length - 1];
}

/** The Chinese rendering when the translation table has caught up with the live
    feed, else Tibo's original English — never an empty box. */
function quoteOf(post: { zh: string | null; en: string }) {
  return post.zh ?? post.en;
}

const groups: { label: string; events: typeof events }[] = [];
for (const event of events) {
  const label = monthFmt.format(new Date(eventTime(event)));
  const last = groups[groups.length - 1];
  if (last && last.label === label) {
    last.events.push(event);
  } else {
    groups.push({ label, events: [event] });
  }
}

const elapsedDays = latestReset ? daysSince(latestReset.confirmedAt ?? eventTime(latestReset)) : null;

/** "等不及了"计数按重置周期分轮：以最近一次已确认重置的北京日期为轮次。 */
const impatientCycle = latestReset ? eventTime(latestReset).slice(0, 10) : "none";

/** 上一轮的人数读仓库里冻结的轮次档案（impatient.json），不再运行时访问计数
    服务。按日期分轮自 2026-09-23 起，更早的轮次都累计在旧全局 key 的合计
    档案里，一并视为「上一轮」。 */
const prevRound =
  impatientCycle === "none" ? null : previousRound(impatientSnapshot, impatientCycle);
const legacyRound = impatientSnapshot.rounds.find((round) => round.cycle === null) ?? null;

const historyFrom = dayFmt.format(new Date(allResetSnapshot.historyFrom));
const checkedAt = dtFmt.format(new Date(allResetSnapshot.checkedAt));
const intervalsText = intervals
  ? ui.intervalsTemplate
      .replace("{min}", String(intervals.min))
      .replace("{median}", String(intervals.median))
      .replace("{max}", String(intervals.max))
      .replace("{count}", String(intervals.count))
  : "";
const historySummary = ui.historySummaryTemplate
  .replace("{from}", historyFrom)
  .replace("{total}", String(allResets.length))
  .replace("{resets}", String(resetCount))
  .replace("{cards}", String(cardCount));
---

<BaseLayout
  locale="zh"
  route="/codex-reset/"
  title={`${ui.codexResetTitle} — eggx`}
  description={ui.codexResetBlurb}
>
  <div class="main-inner">
    <header class="page-head">
      <h1>{ui.codexResetTitle}</h1>
      <p>{ui.codexResetBlurb}</p>
    </header>

    <div class="reset-grid">
      <article class="offer-card">
        <div class="offer-head">
          <h2 class="reset-card-title">{ui.lastResetHeading}</h2>
          {latestReset && (
            <span class="tag tag-outline">
              {latestReset.type === "reset" ? ui.resetTypeLabel : ui.cardTypeLabel}
            </span>
          )}
          {latestReset && <span class="tag tag-verified">{ui.confirmedTag}</span>}
        </div>
        {latestReset ? (
          <>
            <p class="reset-when">
              {dtFmt.format(new Date(latestReset.confirmedAt ?? eventTime(latestReset)))}
              <span class="reset-tz">北京时间</span>
            </p>
            {elapsedDays !== null && (
              <p class="reset-elapsed">
                <span class="badge-elapsed" data-since={latestReset.confirmedAt ?? eventTime(latestReset)}>
                  {elapsedDays <= 0 ? ui.todayLabel : ui.daysAgoLabel.replace("{n}", String(elapsedDays))}
                </span>
              </p>
            )}
            <div class="impatient-row">
              <div class="impatient-action">
                <button
                  type="button"
                  class="btn btn-impatient"
                  id="impatient-btn"
                  aria-label={ui.impatientAction}
                >
                  <span class="impatient-emoji" aria-hidden="true">🙏</span>
                  <span class="impatient-label" data-impatient-label>{ui.impatientAction}</span>
                  <span class="impatient-count-slot">
                    <span
                      class="impatient-count"
                      data-impatient-count
                      role="status"
                      aria-live="polite"
                      aria-atomic="true"
                      aria-label={ui.impatientUnavailableAria}>—</span
                    >
                  </span>
                </button>
                <span class="impatient-bursts" data-impatient-bursts aria-hidden="true"></span>
              </div>
              <span class="impatient-meta">
                <span class="impatient-hint" data-impatient-hint>{ui.impatientHint}</span>
                {prevRound && (
                  <span class="impatient-prev">
                    {ui.impatientPrevTemplate.replace("{n}", String(prevRound.final))}
                  </span>
                )}
              </span>
            </div>
            <blockquote class="reset-quote">
              {quoteOf(primaryPost(latestReset))}
              <footer>
                <a href={primaryPost(latestReset).url} rel="noopener" target="_blank">{ui.sourcePostLabel}</a>
              </footer>
            </blockquote>
          </>
        ) : (
          <p class="empty">还没有已确认的重置记录。</p>
        )}
      </article>

      <article class="offer-card">
        <div class="offer-head">
          <h2 class="reset-card-title">{ui.sinceResetHeading}</h2>
        </div>
        {latestReset && elapsedDays !== null ? (
          <>
            <p class="reset-when">
              <span class="badge-elapsed" data-since={latestReset.confirmedAt ?? eventTime(latestReset)}>
                {elapsedDays <= 0 ? ui.todayLabel : ui.daysAgoLabel.replace("{n}", String(elapsedDays))}
              </span>
            </p>
            <p class="stat-line" data-intervals>{intervalsText}</p>
          </>
        ) : (
          <p class="stat-line" data-intervals>{intervalsText}</p>
        )}
        <p class="reset-note">{ui.estimateNote}</p>
        <a
          class="btn btn-primary offer-action"
          href="https://x.com/thsottiaux"
          rel="noopener"
          target="_blank">{ui.followAction}</a
        >
      </article>
    </div>

    <section class="reset-history">
      <h2>{ui.historyHeading}</h2>
      <p class="reset-summary">{historySummary}</p>
      {legacyRound && (
        <p class="reset-summary reset-legacy-note">
          {ui.impatientLegacyTemplate.replace("{n}", String(legacyRound.final))}
        </p>
      )}

      {groups.map((group, index) => (
        <details class="reset-month" open={index === 0}>
          <summary class="reset-month-summary">
            <h3 class="reset-month-label">{group.label}</h3>
            <span class="reset-month-count">
              {ui.monthSummaryTemplate.replace("{n}", String(group.events.length))}
            </span>
          </summary>
          <div class="reset-month-body">
            {group.events.map((event) => {
              const post = primaryPost(event);
              const confirmed = isConfirmed(event);
              const scope = scopeText(event, "zh");
              const round = confirmed
                ? roundForCycle(impatientSnapshot, eventTime(event).slice(0, 10))
                : null;
              return (
                <article class="reset-row">
                  <div class="reset-row-head">
                    <span class="reset-row-time">
                      {dtFmt.format(new Date(eventTime(event)))}
                    </span>
                    <span class="tag tag-outline">
                      {event.type === "reset" ? ui.resetTypeLabel : ui.cardTypeLabel}
                    </span>
                    <span class:list={["tag", confirmed ? "tag-verified" : "tag-community"]}>
                      {confirmed ? ui.confirmedTag : ui.announcedTag}
                    </span>
                  </div>
                  {scope && (
                    <p class="reset-scope">{ui.scopeLabel}：{scope}</p>
                  )}
                  {round && (
                    <p class="reset-round">
                      {ui.impatientRoundTemplate.replace("{n}", String(round.final))}
                    </p>
                  )}
                  <blockquote class="reset-quote reset-quote-row">
                    {quoteOf(post)}
                    <footer>
                      <a href={post.url} rel="noopener" target="_blank">{ui.sourcePostLabel}</a>
                    </footer>
                  </blockquote>
                </article>
              );
            })}
          </div>
        </details>
      ))}
    </section>

    <section class="prose reset-method">
      <h2>{ui.methodHeading}</h2>
      <ul>
        <li>
          <strong>来源</strong> — 只记录 Tibo（@thsottiaux）在 X 上的公开宣布。实时数据整理自
          <a href={allResetSnapshot.source} rel="noopener" target="_blank">codex-resets.com</a
          >（依其条款署名），引文为英文原文，其中中文引文来自
          <a href="https://aihot.news/codex-reset" rel="noopener" target="_blank">AIHOT</a
          > 的 AI 翻译（© AIHOT）；点「原推」查看英文原文。2026-10-11 及以前的历史分两段冻结留存：
          2026-06-12 起来自 AIHOT（中文引文为其 AI 翻译，含确认帖与单独核实的执行日期），
          2026-06 前回填自 codex-resets.com（eggx 自译，时间为公告时间、无单独核实的执行日期）。
        </li>
        <li>
          <strong>口径</strong> — 「全员重置」指所有付费账户的 Codex 额度被清零；
          「发重置卡」指向账户发放可自助使用的重置卡。两类事件都计入
          「最近一次」与间隔统计，且仅计已确认的事件。实时段「已确认」指信源已了结该重置
          （待执行的公告单独标「已预告」）；冻结段取 Tibo 确认推文的发布时间。两者都不是精确执行时间。
        </li>
        <li>
          <strong>间隔统计</strong> — 按确认日期去重后（同日多轮只计一天）
          计算相邻两次重置（全员重置或发重置卡）的间隔，自 {historyFrom} 起。
        </li>
        <li><strong>时区</strong> — 全部使用北京时间（UTC+8）。</li>
        <li>
          <strong>免责</strong> — 本页非 OpenAI 官方页面；是否重置、何时重置由 OpenAI 决定，
          任何基于历史间隔的推断仅供参考。
        </li>
        <li>
          <strong>更新</strong> — 定时任务每小时自动同步上游并重建本页；实时上游
          codex-resets.com 持续跟踪 Tibo 的公开帖，本次核验至 {checkedAt}。
        </li>
      </ul>
    </section>

    <p class="reset-footnote">
      快照核验至 {checkedAt} · 实时整理自
      <a href={allResetSnapshot.source} rel="noopener" target="_blank">codex-resets.com</a>
      · 中文引文译自
      <a href="https://aihot.news/codex-reset" rel="noopener" target="_blank">AIHOT</a>
      · 2026-10-11 前历史冻结留存 · 非 OpenAI 官方页面
    </p>
  </div>

  <script
    type="application/json"
    id="eggx-reset-i18n"
    set:html={JSON.stringify({ todayLabel: ui.todayLabel, daysAgoLabel: ui.daysAgoLabel })}
  />
  <script
    type="application/json"
    id="eggx-impatient"
    set:html={JSON.stringify({
      base: "https://abacus.jasoncameron.dev",
      ns: "eggx-wehuman",
      key: `codex-reset-impatient-${impatientCycle}`,
      locale: "zh-CN",
      pollMs: 30_000,
      countAriaTemplate: ui.impatientCountAriaTemplate,
      unavailableLabel: ui.impatientUnavailable,
      unavailableAria: ui.impatientUnavailableAria,
      pool: ui.impatientPool,
    })}
  />
  {/* The static HTML carries build-day "N 天前" values; recompute at view time
      from Beijing calendar dates so the page stays honest between deploys. */}
  <script is:inline>
    (function () {
      var cfg = document.getElementById("eggx-reset-i18n");
      if (!cfg) return;
      var labels = JSON.parse(cfg.textContent || "{}");
      var BJ_OFFSET = 8 * 3600000;
      function beijingDay(ms) {
        var d = new Date(ms + BJ_OFFSET);
        return Date.UTC(d.getUTCFullYear(), d.getUTCMonth(), d.getUTCDate());
      }
      var today = beijingDay(Date.now());
      document.querySelectorAll("[data-since]").forEach(function (el) {
        var then = beijingDay(Date.parse(el.getAttribute("data-since")));
        var days = Math.round((today - then) / 86400000);
        el.textContent =
          days <= 0 ? labels.todayLabel : labels.daysAgoLabel.replace("{n}", String(days));
      });
    })();
  </script>
  {/* 「等不及了」按钮：可连点，每次点击即时 +1（abacus 的 hit 一次只加一，连点
      无法合并批量）；全局计数来自免费的第三方计数器，加载失败降级为「—」并提示
      不可用。标签页可见时每 30s 轮询一次，计数上涨说明有别人在点，飘一个不带国家
      的远程粒子。所有动画尊重 prefers-reduced-motion。 */}
  <script is:inline>
    (function () {
      var cfgEl = document.getElementById("eggx-impatient");
      var btn = document.getElementById("impatient-btn");
      var countEl = document.querySelector("[data-impatient-count]");
      var hintEl = document.querySelector("[data-impatient-hint]");
      var burstsEl = document.querySelector("[data-impatient-bursts]");
      if (!cfgEl || !btn || !countEl || !burstsEl) return;
      var cfg = JSON.parse(cfgEl.textContent || "{}");
      var nf = new Intl.NumberFormat(cfg.locale || "zh-CN");
      var reduceMotion =
        window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      var pool = cfg.pool || [];
      var lastCount = null;
      var pollTimer = null;
      var defaultHint = hintEl ? hintEl.textContent : "";

      function setHint(text) {
        if (hintEl && text) hintEl.textContent = text;
      }

      function showUnavailable() {
        // 偶发的轮询失败不清掉已知计数：「—」只在从未拿到过数值时出现。
        if (lastCount === null) {
          countEl.textContent = "—";
          countEl.setAttribute("aria-label", cfg.unavailableAria);
        }
        setHint(cfg.unavailableLabel);
      }

      function renderCount(n) {
        setHint(defaultHint);
        var text = nf.format(n);
        if (countEl.textContent !== text) {
          countEl.textContent = text;
          countEl.setAttribute("aria-label", cfg.countAriaTemplate.replace("{n}", text));
          // 计数位数变化会让按钮宽度跳动：首次渲染后钉住最小宽度。
          if (!countEl.style.minWidth) {
            var w = parseFloat(getComputedStyle(countEl).width);
            if (w > 0) countEl.style.minWidth = w + "px";
          }
          if (lastCount !== null && n > lastCount && !reduceMotion) {
            countEl.classList.remove("is-bump");
            void countEl.offsetWidth;
            countEl.classList.add("is-bump");
          }
        }
        lastCount = n;
      }

      function haptic() {
        try {
          if (typeof navigator.vibrate === "function") navigator.vibrate(14);
        } catch (e) {
          /* 震动不可用时静默跳过 */
        }
      }

      function pulse() {
        btn.classList.remove("is-pleading");
        void btn.offsetWidth;
        btn.classList.add("is-pleading");
      }

      function burst(remote) {
        if (reduceMotion) return;
        var from = remote ? ["🙏"] : pool;
        var text = from[Math.floor(Math.random() * from.length)];
        if (!text) return;
        var el = document.createElement("span");
        el.className = "impatient-burst" + (remote ? " impatient-burst--remote" : "");
        el.textContent = text;
        el.style.setProperty("--burst-x", Math.round(Math.random() * 64 - 48) + "px");
        el.style.setProperty("--burst-y", -58 - Math.round(Math.random() * 42) + "px");
        el.style.setProperty("--burst-rotate", Math.round(Math.random() * 28 - 14) + "deg");
        el.style.setProperty("--burst-size", 18 + Math.round(Math.random() * 6) + "px");
        burstsEl.appendChild(el);
        while (burstsEl.childElementCount > 12) burstsEl.firstElementChild.remove();
        el.addEventListener("animationend", function () {
          el.remove();
        });
      }

      function fetchCount() {
        fetch(cfg.base + "/get/" + cfg.ns + "/" + cfg.key)
          .then(function (r) {
            // 新周期还没有人点过，key 不存在，abacus 返回 404——读作 0，不算故障。
            if (r.status === 404) return { value: 0 };
            return r.ok ? r.json() : null;
          })
          .then(function (d) {
            if (d && typeof d.value === "number") {
              if (lastCount !== null && d.value > lastCount) burst(true);
              renderCount(d.value);
            } else {
              showUnavailable();
            }
          })
          .catch(showUnavailable);
      }

      function startPolling() {
        if (pollTimer || document.hidden) return;
        pollTimer = setInterval(fetchCount, cfg.pollMs || 30000);
      }

      function stopPolling() {
        if (pollTimer) {
          clearInterval(pollTimer);
          pollTimer = null;
        }
      }

      document.addEventListener("visibilitychange", function () {
        if (document.hidden) {
          stopPolling();
        } else {
          fetchCount();
          startPolling();
        }
      });

      btn.addEventListener("click", function () {
        haptic();
        pulse();
        burst(false);
        fetch(cfg.base + "/hit/" + cfg.ns + "/" + cfg.key)
          .then(function (r) {
            return r.ok ? r.json() : null;
          })
          .then(function (d) {
            if (d && typeof d.value === "number") renderCount(d.value);
            else setHint(cfg.unavailableLabel);
          })
          .catch(function () {
            setHint(cfg.unavailableLabel);
          });
      });

      btn.addEventListener("animationend", function (e) {
        if (e.target === btn) btn.classList.remove("is-pleading");
      });
      countEl.addEventListener("animationend", function () {
        countEl.classList.remove("is-bump");
      });

      fetchCount();
      startPolling();
    })();
  </script>
</BaseLayout>

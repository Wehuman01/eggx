---
import type { OfferStatus } from "../lib/schema";

interface Props {
  status: OfferStatus;
}

const { status } = Astro.props;

// Status is expressed through a labelled badge, never colour alone.
const LABELS: Record<OfferStatus, string> = {
  verified: "Verified",
  provisional: "Provisional",
  expiring: "Expiring soon",
  archived: "Archived",
};
---

<span class={`badge badge-${status}`} title={`Status: ${LABELS[status]}`}>
  {LABELS[status]}
</span>
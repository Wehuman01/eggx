---
import type { Offer } from "../lib/schema";
import type { Locale } from "../lib/i18n";
import { UI } from "../lib/i18n";
import { expiryBadgeLabel, shortUrlText } from "../lib/offers";

interface Props {
  offer: Offer;
  locale: Locale;
}

const { offer, locale } = Astro.props;
const ui = UI[locale];
const loc = offer[locale];
const showPageLink = Boolean(offer.url && offer.url !== offer.actionUrl && offer.url !== offer.source);

let expiryBadge: string | null = null;
if (offer.kind === "temporary" && offer.expiry) {
  expiryBadge = expiryBadgeLabel(offer.expiry, new Date(), ui);
}
---

<article class="offer-card">
  <div class="offer-head">
    <h3 class="offer-name">{loc.name}</h3>
    <div class="offer-tags">
      <span class:list={["tag", offer.verified ? "tag-verified" : "tag-community"]}>
        {offer.verified ? ui.verifiedTag : ui.communityTag}
      </span>
    </div>
  </div>

  <p class="offer-provider">{offer.provider}</p>
  <p class="offer-desc">{loc.description}</p>

  <ul class="offer-facts">
    {offer.kind === "temporary" && (
      <li>
        <span class="fact-label">{ui.expiryLabel}</span>
        {offer.expiry ?? <span>{ui.noEndDate}</span>}
        {expiryBadge && (
          <span class="badge badge-countdown" data-expiry={offer.expiry}>{expiryBadge}</span>
        )}
      </li>
    )}
    {loc.limits && (
      <li>
        <span class="fact-label">{ui.limitsLabel}</span>
        {loc.limits}
      </li>
    )}
  </ul>

  {loc.caveat && <p class="offer-caveat">{loc.caveat}</p>}

  {offer.actionUrl && (
    <a class="btn btn-primary offer-action" href={offer.actionUrl} rel="noopener" target="_blank">
      {offer.access === "application" ? ui.applyAction : ui.claimAction}
    </a>
  )}

  <footer class="offer-meta">
    {offer.source && (
      <span>
        {ui.sourceLabel}: <a href={offer.source} rel="noopener" target="_blank">{shortUrlText(offer.source)}</a>
      </span>
    )}
    {showPageLink && (
      <span>
        {ui.pageLabel}: <a href={offer.url} rel="noopener" target="_blank">{shortUrlText(offer.url!)}</a>
      </span>
    )}
    {offer.lastVerified && <span>{ui.verifiedOn(offer.lastVerified)}</span>}
  </footer>
</article>
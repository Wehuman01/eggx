---
import "../styles/global.css";
import type { Locale, RouteKey } from "../lib/i18n";
import { UI, pageUrl, altLocale, withBase } from "../lib/i18n";
import type { JsonLdObject } from "../lib/jsonld";

interface Props {
  locale: Locale;
  route: RouteKey;
  title: string;
  description: string;
  structuredData?: JsonLdObject[];
}

const { locale, route, title, description, structuredData } = Astro.props;

const ui = UI[locale];
const langUrl = pageUrl(altLocale(locale), route);

const canonical = new URL(Astro.url.pathname, Astro.site);
const absolute = (path: string) => new URL(path, Astro.site).href;

const ogImage = absolute(withBase("og-default.png"));
const ogLocale = locale === "zh" ? "zh_CN" : "en_US";
const ogAltLocale = locale === "zh" ? "en_US" : "zh_CN";
const altLangUrl = absolute(langUrl);
const defaultLangUrl = absolute(pageUrl("zh", route));
const rssUrl = absolute(withBase("feed.xml"));
const altHtmlLang = UI[altLocale(locale)].htmlLang;

const websiteSchema: JsonLdObject = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "eggx",
  url: absolute(withBase("/")),
  description,
  inLanguage: ui.htmlLang,
};
const allSchemas = [websiteSchema, ...(structuredData ?? [])];

const navDeals = [
  { route: "/", label: ui.navTemporary },
  { route: "/long-term/", label: ui.navLongTerm },
  { route: "/application/", label: ui.navApplication },
] as const;

const navTracking = [
  { route: "/codex-reset/", label: ui.navCodexReset },
  { route: "/aweshare/", label: ui.navAweshare },
] as const;

const navMore = [
  { route: "/submit/", label: ui.navSubmit },
  { route: "/agent/", label: ui.navAgent },
  { route: "/about/", label: ui.navAbout },
] as const;
---

<!doctype html>
<html lang={ui.htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={ui.htmlLang} href={canonical.href} />
    <link rel="alternate" hreflang={altHtmlLang} href={altLangUrl} />
    <link rel="alternate" hreflang="x-default" href={defaultLangUrl} />
    <link rel="icon" type="image/svg+xml" href={withBase("favicon.svg")} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="alternate" type="application/rss+xml" title="eggx" href={rssUrl} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="eggx" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:locale:alternate" content={ogAltLocale} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify(allSchemas)} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&family=Inter:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="shell">
      <aside class="sidebar">
        <div class="sidebar-brand">
          <a class="brand-row" href={pageUrl(locale, "/")}>
            <svg class="brand-logo" viewBox="0 0 64 64" aria-hidden="true">
              <path
                class="logo-egg"
                d="M32 6 C 26 6 18 15.5 15.5 25 C 13 34.5 15.5 46 22 52.5 C 26.5 57 37.5 57 42 52.5 C 48.5 46 51 34.5 48.5 25 C 46 15.5 38 6 32 6 Z"
              />
              <line class="logo-x" x1="24" y1="24" x2="40" y2="40" />
              <line class="logo-x" x1="40" y1="24" x2="24" y2="40" />
            </svg>
            <span class="brand-name">eggx</span>
          </a>
          <p class="brand-tagline">{ui.siteTagline}</p>
        </div>

        <nav class="sidebar-nav" aria-label="Primary">
          <p class="nav-group-label">{ui.navGroupDeals}</p>
          <ul class="nav-list">
            {navDeals.map((item) => {
              const href = pageUrl(locale, item.route);
              const active = route === item.route;
              return (
                <li>
                  <a class:list={["nav-link", { active }]} href={href}>{item.label}</a>
                </li>
              );
            })}
            <li>
              <a
                class:list={["nav-link", "nav-link-dead", { active: route === "/expired/" }]}
                href={pageUrl(locale, "/expired/")}
              >
                <span class="nav-dead-mark" aria-hidden="true">☠</span>
                {ui.navExpired}
              </a>
            </li>
          </ul>

          <p class="nav-group-label">{ui.navGroupTracking}</p>
          <ul class="nav-list">
            {navTracking.map((item) => {
              const href = pageUrl(locale, item.route);
              const active = route === item.route;
              return (
                <li>
                  <a class:list={["nav-link", { active }]} href={href}>{item.label}</a>
                </li>
              );
            })}
          </ul>

          <p class="nav-group-label">{ui.navGroupMore}</p>
          <ul class="nav-list">
            {navMore.map((item) => {
              const href = pageUrl(locale, item.route);
              const active = route === item.route;
              return (
                <li>
                  <a class:list={["nav-link", { active }]} href={href}>{item.label}</a>
                </li>
              );
            })}
          </ul>
        </nav>

        <div class="sidebar-actions">
          <a class="github-star" href="https://github.com/wehuman01/eggx" rel="noopener" target="_blank">★ GitHub</a>
          <a class="lang-switch" href={langUrl}>{ui.langName}</a>
        </div>
      </aside>

      <main class="main">
        <slot />
      </main>
    </div>

    <script
      type="application/json"
      id="eggx-badge-i18n"
      set:html={JSON.stringify({
        expiringToday: ui.expiringToday,
        expiredTag: ui.expiredTag,
        daysLeftOne: ui.daysLeftOne,
        daysLeftOther: ui.daysLeftOther,
      })}
    />
    {/* Recompute countdown badges at view time: the static HTML carries the
        build-day value; this keeps it honest until the next deploy. */}
    <script is:inline>
      (function () {
        var cfg = document.getElementById("eggx-badge-i18n");
        if (!cfg) return;
        var labels = JSON.parse(cfg.textContent || "{}");
        function badgeLabel(days) {
          if (days < 0) return labels.expiredTag;
          if (days === 0) return labels.expiringToday;
          var template = days === 1 ? labels.daysLeftOne : labels.daysLeftOther;
          return template.replace("{n}", String(days));
        }
        function update() {
          var now = new Date();
          var todayUtc = Date.UTC(now.getUTCFullYear(), now.getUTCMonth(), now.getUTCDate());
          document.querySelectorAll("[data-expiry]").forEach(function (el) {
            var target = Date.parse(el.getAttribute("data-expiry") + "T00:00:00Z");
            if (!Number.isNaN(target)) {
              el.textContent = badgeLabel(Math.round((target - todayUtc) / 86400000));
            }
          });
        }
        update();
        setInterval(update, 3600000);
      })();
    </script>
  </body>
</html>